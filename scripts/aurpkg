#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage: aurpkg [flags]

Required flags:
  --version <vX.Y.Z>         Release version (with 'v' prefix)
  --license-sha256 <sha256>  SHA256 of the LICENSE file at this tag
  --readme-sha256 <sha256>   SHA256 of the README.md file at this tag
  --x86_64-sha256 <sha256>   SHA256 of the linux x86_64 release tarball
  --output-dir <path>        Directory to write PKGBUILD and .SRCINFO into

Optional flags:
  --pkgrel <int>             Package release number (default: 1)
EOF
  exit 1
}

VERSION=""
PKGREL="1"
LICENSE_SHA=""
README_SHA=""
X86_64_SHA=""
OUTPUT_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version) VERSION="$2"; shift 2 ;;
    --pkgrel) PKGREL="$2"; shift 2 ;;
    --license-sha256) LICENSE_SHA="$2"; shift 2 ;;
    --readme-sha256) README_SHA="$2"; shift 2 ;;
    --x86_64-sha256) X86_64_SHA="$2"; shift 2 ;;
    --output-dir) OUTPUT_DIR="$2"; shift 2 ;;
    *) echo "unknown flag: $1" >&2; usage ;;
  esac
done

# Validate required flags
for f in VERSION LICENSE_SHA README_SHA X86_64_SHA OUTPUT_DIR; do
  if [[ -z "${!f:-}" ]]; then
    echo "ERROR: --${f,,} is required" >&2
    usage
  fi
done

# Validate version format
if [[ ! "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "ERROR: --version must match vX.Y.Z format (got '$VERSION')" >&2
  exit 1
fi

# Validate pkgrel is a positive integer
if [[ ! "$PKGREL" =~ ^[1-9][0-9]*$ ]]; then
  echo "ERROR: --pkgrel must be a positive integer (got '$PKGREL')" >&2
  exit 1
fi

# Validate SHA256 lengths
validate_sha() {
  local label="$1" val="$2"
  if [[ ! "$val" =~ ^[0-9a-f]{64}$ ]]; then
    echo "ERROR: $label must be a 64-character hex string" >&2
    exit 1
  fi
}
validate_sha "license-sha256" "$LICENSE_SHA"
validate_sha "readme-sha256" "$README_SHA"
validate_sha "x86_64-sha256" "$X86_64_SHA"

# Create output directory
mkdir -p "$OUTPUT_DIR"

# Strip 'v' prefix for pkgver
pkgver="${VERSION#v}"

ARCHIVE_NAME="opcda-bridge-client-linux-x86_64.tar.gz"

cat > "$OUTPUT_DIR/PKGBUILD" << BUILDEOF
# Maintainer: Mike Boiko <mike@boiko.ca>
# This file is generated by scripts/aurpkg. Do not edit by hand.

pkgname=opcda-bridge-client-bin
pkgver=$pkgver
pkgrel=$PKGREL
pkgdesc='OPC DA cross-platform client'
arch=('x86_64')
url='https://github.com/mikeboiko/opcda-bridge'
license=('MIT')
provides=('opcda-bridge-client')
conflicts=('opcda-bridge-client')

source=("LICENSE::https://raw.githubusercontent.com/mikeboiko/opcda-bridge/v\${pkgver}/LICENSE"
        "README.md::https://raw.githubusercontent.com/mikeboiko/opcda-bridge/v\${pkgver}/README.md")
sha256sums=('$LICENSE_SHA'
            '$README_SHA')
source_x86_64=("\${pkgname}-\${pkgver}-x86_64.tar.gz::https://github.com/mikeboiko/opcda-bridge/releases/download/v\${pkgver}/$ARCHIVE_NAME")
sha256sums_x86_64=('$X86_64_SHA')

package() {
    install -Dm755 "opcda-bridge-client" "\${pkgdir}/usr/bin/opcda-bridge-client"
    install -Dm644 "LICENSE" "\${pkgdir}/usr/share/licenses/\${pkgname}/LICENSE"
    install -Dm644 "README.md" "\${pkgdir}/usr/share/doc/\${pkgname}/README.md"
}
BUILDEOF

cat > "$OUTPUT_DIR/.SRCINFO" << SRCINFOEOF
pkgbase = opcda-bridge-client-bin
	pkgdesc = OPC DA cross-platform client
	pkgver = $pkgver
	pkgrel = $PKGREL
	url = https://github.com/mikeboiko/opcda-bridge
	arch = x86_64
	license = MIT
	provides = opcda-bridge-client
	conflicts = opcda-bridge-client
	source = LICENSE::https://raw.githubusercontent.com/mikeboiko/opcda-bridge/v$pkgver/LICENSE
	source = README.md::https://raw.githubusercontent.com/mikeboiko/opcda-bridge/v$pkgver/README.md
	sha256sums = $LICENSE_SHA
	sha256sums = $README_SHA
	source_x86_64 = opcda-bridge-client-bin-\$pkgver-x86_64.tar.gz::https://github.com/mikeboiko/opcda-bridge/releases/download/v$pkgver/$ARCHIVE_NAME
	sha256sums_x86_64 = $X86_64_SHA

pkgname = opcda-bridge-client-bin
SRCINFOEOF
